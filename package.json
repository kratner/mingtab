{
  "name": "mingtab",
  "version": "0.8.0",
  "private": true,
  "description": "A local-first tab manager for Chrome: save, organize and restore tabs.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run e2e && npm --prefix worker test",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fractional-indexing": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
