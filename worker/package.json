{
  "name": "mingtab-sync",
  "version": "0.0.1",
  "private": true,
  "description": "MingTab sync service: Cloudflare Worker + D1.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply mingtab --local",
    "db:migrate:remote": "wrangler d1 migrations apply mingtab --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
